{
  "name": "flowcare-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --target bun --outdir dist",
    "test": "bun test",
    "typecheck": "bun node_modules/typescript/bin/tsc --noEmit",
    "lint": "bun node_modules/@biomejs/biome/bin/biome check",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1146.0",
    "@elysiajs/cors": "^1.3.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.45.1",
    "elysia": "^1.3.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@types/bun": "^1.3.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.23.1",
    "prisma": "~7.10.0",
    "typescript": "^5.9.0"
  }
}

# API
PORT=3001
NODE_ENV=development
# Secrets: gere com `openssl rand -base64 32`. Obrigatórios em produção (fail-fast no boot).
JWT_SECRET=troque-por-um-secret-forte
DATABASE_URL=postgresql://medflow:TROQUE_PELA_SENHA_DO_POSTGRES@localhost:5432/medflow

# CORS (origens separadas por vírgula)
CORS_ORIGIN=http://localhost:3000

# WAHA
WAHA_BASE_URL=http://localhost:3002
# WAHA_API_KEY=

# Mailer: SMTP_URL/MAIL_FROM reservados; envio SMTP ainda não implementado.
# Atualmente os links são registrados no console pelo ConsoleMailer.
SMTP_URL=
MAIL_FROM="MedicalFlow <no-reply@selbr.com>"
APP_WEB_URL=http://localhost:3000
